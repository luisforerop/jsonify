# Clerk authentication (see https://dashboard.clerk.com/ for your app's keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing (defaults scaffolded by `clerk init`)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Postgres connection used by Drizzle (matches docker-compose.yml).
# Run `npm run db:up` to start the local database, then `npm run db:migrate`.
DATABASE_URL=postgres://jsonify:jsonify@localhost:5432/jsonify
